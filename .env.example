# Copy to .env and fill in. .env is gitignored.

# Hetzner Cloud Console -> project -> Security -> API tokens (Read & Write)
HCLOUD_TOKEN=

# From https://platform.deepseek.com -> API keys
DEEPSEEK_API_KEY=

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Public key that will be allowed to SSH in
SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# Optional overrides (defaults shown)
#SERVER_NAME=openclaw
#SERVER_TYPE=cx23
#SERVER_LOCATION=hel1
#SERVER_IMAGE=ubuntu-24.04
#ADMIN_USER=claw
#OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
#OPENCLAW_TZ=Europe/Tallinn
